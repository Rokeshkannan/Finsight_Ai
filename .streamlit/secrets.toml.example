# Copy this file to .streamlit/secrets.toml (same folder) and fill in your key.
# secrets.toml is gitignored -- never commit your real key.
#
# If this key is present, FinSight AI uses it automatically for ALL visitors
# to your deployed app, with a per-session cap (see utils/session_limit.py,
# MAX_REQUESTS_PER_SESSION). If you leave this file absent/empty, the app
# falls back to asking each user for their own key (BYOK), with no cap.

ANTHROPIC_API_KEY = "sk-ant-your-key-here"
